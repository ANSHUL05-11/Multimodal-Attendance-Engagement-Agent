# Multimodal Attendance & Engagement Agent Configuration
APP_NAME="Multimodal Attendance & Engagement Agent"
APP_ENV="development"
DEBUG=True

# Server settings
API_HOST="127.0.0.1"
API_PORT=8000
STREAMLIT_PORT=8501

# Database
DATABASE_URL="sqlite:///./data/attendance_agent.db"

# Vision Processing Defaults
FRAME_SAMPLING_INTERVAL=5
MIN_PRESENCE_SECONDS=10.0
TRACKING_IOU_THRESHOLD=0.3
FACE_DETECTION_CONFIDENCE=0.5

# Audio Processing Defaults
AUDIO_FRAME_LENGTH=2048
AUDIO_HOP_LENGTH=512
VAD_ENERGY_THRESHOLD=0.015

# Privacy & Retention
ENABLE_LOCAL_RECOGNITION=True
DATA_RETENTION_DAYS=30
